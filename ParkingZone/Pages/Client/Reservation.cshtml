@page
@model ParkingZone.Pages.Client.ReservationModel
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Reservas";
    var spacesJson = (string)(ViewData["SpacesJson"] ?? "[]");
    var currentReservation = Model.ActiveReservation;
    var tokens = Antiforgery.GetAndStoreTokens(HttpContext);
}

<!-- token antiforgery accesible por JS -->
<meta name="request-verification-token" content="@tokens.RequestToken" />

@if (currentReservation != null)
{
    <section class="card active">
        <header class="bar">
            <h2>Tu reserva</h2>
            <span class="chip chip-live">Activa</span>
        </header>

        <div class="active-body">
            <div class="active-box">
                <div class="pair"><span>Espacio</span><strong>@currentReservation.Space.Code</strong></div>
                <div class="pair"><span>Inicio</span><strong>@currentReservation.EntryTime.ToLocalTime().ToString("HH:mm:ss")</strong></div>
                <div class="pair"><span>Tiempo restante</span><strong id="timer">--:--</strong></div>
            </div>

            <form method="post" asp-page-handler="Cancel" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn danger">Cancelar</button>
            </form>
        </div>
    </section>

    <script>
        (function(){
            const end = new Date("@currentReservation.EntryTime.AddMinutes(30).ToString("O")");
            const out = document.getElementById("timer");
            function tick(){
                const d = end - new Date();
                if (d <= 0){ out.textContent = "00:00"; location.reload(); return; }
                const m = Math.floor(d/60000), s = Math.floor((d%60000)/1000);
                out.textContent = String(m).padStart(2,"0")+":"+String(s).padStart(2,"0");
            }
            tick(); setInterval(tick,1000);
        })();
    </script>
}
else
{
    <section class="card">
        <header class="bar">
            <div>
                <h2>Reservar un espacio</h2>
                <p class="muted">Haz clic en un espacio del mapa. La reserva dura 30 minutos.</p>
            </div>
            <div class="legend">
                <span class="chip ok">Disponible</span>
                <span class="chip warn">No disponible</span>
                <span class="chip err">Ocupado</span>
            </div>
        </header>

        <!-- MAPA SOBRE IMAGEN CUADRADA (1024 x 1024 viewBox) -->
        <div class="pz-map-wrap square">
            <svg id="pz-map" viewBox="0 0 1024 1024" preserveAspectRatio="xMidYMid meet" class="pz-map">
                <image href="/img/parking-map-final-v7.png" x="0" y="0" width="1024" height="1024" />
                <g id="pz-slots"></g>
            </svg>
        </div>

        <p class="muted" style="margin-top:8px">Pasa el mouse para ver el código. Verde=Libre, Ámbar=No disponible, Rojo=Ocupado.</p>
    </section>

    <div id="toaster" class="toaster" aria-live="polite"></div>

    <script>
        // Datos iniciales desde backend
        // @@ts-ignore
        const PZ_SPACES = (@Html.Raw(spacesJson));


        // Antiforgery
        const XSRF = document.querySelector('meta[name="request-verification-token"]')?.content ?? "";

        // --- POSICIONES (coinciden con un campo tipo el de tu imagen) ---
        // 5 arriba y 5 abajo para autos (#001..#010)
        // 5 motos al centro-derecha (#M001..#M005)
        // Cada objeto: x,y,w,h en viewBox 1024x1024
                // --- POSICIONES (coinciden con tu imagen 1024x1024 v7) ---
        const POSITIONS = {
            "001": { x: 70,  y: 260, w: 120, h: 70, r: 10 },
            "002": { x: 200, y: 260, w: 120, h: 70, r: 10 },
            "003": { x: 400, y: 260, w: 120, h: 70, r: 10 },
            "004": { x: 500, y: 260, w: 120, h: 70, r: 10 },
            "005": { x: 600, y: 260, w: 120, h: 70, r: 10 },

            // AUTOS (abajo) — centrados en su cuadro
            "006": { x: 70,  y: 690, w: 120, h: 70, r: 10 },
            "007": { x: 200, y: 690, w: 120, h: 70, r: 10 },
            "008": { x: 400, y: 690, w: 120, h: 70, r: 10 },
            "009": { x: 500, y: 690, w: 120, h: 70, r: 10 },
            "010": { x: 500, y: 690, w: 120, h: 70, r: 10 },

            // MOTOS (v7: más grandes, separadas y sin línea amarilla)
            "M001": { x: 880, y: 370, w: 90,  h: 55, r: 8 },
          "M002": { x: 880, y: 465, w: 90,  h: 55, r: 8 },
          "M003": { x: 880, y: 560, w: 90,  h: 55, r: 8 },
          "M004": { x: 880, y: 655, w: 90,  h: 55, r: 8 },
          "M005": { x: 880, y: 750, w: 90,  h: 55, r: 8 },
        };


        const layer = document.getElementById("pz-slots");
        const toast = document.getElementById("toaster");

        // Render inicial
        render(PZ_SPACES);

        // Polling cada 5s
        setInterval(async () => {
            try {
                const res = await fetch("/Client/Reservation?handler=Map");
                if (!res.ok) return;
                const fresh = await res.json();
                render(fresh);
            } catch {}
        }, 5000);

        function render(spaces){
            layer.innerHTML = "";
            for (const s of spaces){
                const pos = POSITIONS[s.code];
                if (!pos) continue;

                const color = stateColor(s.state);
                const rect = document.createElementNS("http://www.w3.org/2000/svg","rect");
                rect.setAttribute("x", pos.x);
                rect.setAttribute("y", pos.y);
                rect.setAttribute("width", pos.w);
                rect.setAttribute("height", pos.h);
                rect.setAttribute("rx", pos.r || 6);
                rect.setAttribute("fill", color.fill);
                rect.setAttribute("stroke", color.stroke);
                rect.setAttribute("stroke-width", 3);
                rect.classList.add("pz-slot", `is-${s.state}`);
                rect.setAttribute("aria-label", `Espacio ${s.code} — ${humanState(s.state)}`);

                if (s.state === "available"){
                    rect.style.cursor = "pointer";
                    rect.addEventListener("click", () => reserve(s.id, rect));
                } else {
                    rect.style.cursor = "not-allowed";
                }

                // etiqueta discreta
                const label = document.createElementNS("http://www.w3.org/2000/svg","text");
                label.setAttribute("x", pos.x + pos.w/2);
                label.setAttribute("y", pos.y + pos.h/2 + 5);
                label.setAttribute("text-anchor", "middle");
                label.setAttribute("font-size", 14);
                label.setAttribute("font-weight", "700");
                label.setAttribute("fill", "#e7eefc");
                label.textContent = `#${s.code}`;

                layer.appendChild(rect);
                layer.appendChild(label);
            }
        }

        function humanState(st){ return st==="busy"?"Ocupado":st==="reserved"?"No disponible":"Disponible"; }
        function stateColor(st){
            if (st === "available") return { fill: "rgba(16,185,129,.25)", stroke: "rgba(16,185,129,.95)" };   // verde
            if (st === "reserved")  return { fill: "rgba(245,158,11,.20)", stroke: "rgba(245,158,11,.95)" };   // ámbar
            return { fill: "rgba(239,68,68,.20)", stroke: "rgba(239,68,68,.95)" };                             // rojo
        }

        async function reserve(spaceId, rectEl){
            rectEl.classList.add("pz-busy");
            try{
                const res = await fetch("/Client/Reservation?handler=Create", {
                    method: "POST",
                    headers: {
                        "Content-Type":"application/json",
                        "RequestVerificationToken": XSRF
                    },
                    body: JSON.stringify({ spaceId })
                });

                if (res.ok){
                    showToast("Reserva creada, actualizando…", "ok");
                    setTimeout(()=>location.reload(), 600);
                } else {
                    const msg = await res.text();
                    showToast(msg || "No se pudo reservar el espacio.", "err");
                    rectEl.classList.remove("pz-busy");
                }
            } catch {
                showToast("Error de red. Intenta de nuevo.", "err");
                rectEl.classList.remove("pz-busy");
            }
        }

        function showToast(msg, kind){
            const t = document.createElement("div");
            t.className = `toast ${kind}`;
            t.textContent = msg;
            toast.appendChild(t);
            requestAnimationFrame(()=>t.classList.add("show"));
            setTimeout(()=>{ t.classList.remove("show"); setTimeout(()=>t.remove(), 200); }, 2500);
        }
    </script>
}

<style>
    :root {
        --bg: #0f172a;
        --panel: #0b1222;
        --panel2: #0e1a31;
        --border: #1f2a44;
        --muted: #93a4bf;
        --txt: #e7eefc;
        --r: 14px;
    }

    body {
        background: linear-gradient(180deg,#0a1020,#0f1730 45%,#0b1222);
    }

    .card {
        background: linear-gradient(180deg,var(--panel),var(--panel2));
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 22px;
        color: var(--txt);
        box-shadow: 0 8px 24px rgba(0,0,0,.35)
    }

    .bar {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: end;
        flex-wrap: wrap;
        border-bottom: 1px solid var(--border);
        padding-bottom: 12px;
        margin-bottom: 18px
    }

    .muted {
        color: var(--muted);
        font-size: .95rem
    }

    .legend {
        display: flex;
        gap: 8px;
        flex-wrap: wrap
    }

    .chip {
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 4px 10px;
        font-weight: 600
    }

        .chip.ok {
            background: rgba(16,185,129,.12);
            color: #b6ffe0
        }

        .chip.warn {
            background: rgba(245,158,11,.12);
            color: #ffe1b3
        }

        .chip.err {
            background: rgba(239,68,68,.12);
            color: #ffb8b8
        }

    .chip-live {
        background: rgba(59,130,246,.12);
        color: #b3d0ff
    }

    .active {
        max-width: 600px;
        margin-inline: auto
    }

    .active-body {
        display: grid;
        gap: 18px
    }

    .active-box {
        display: grid;
        gap: 10px;
        background: #0b152a;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 14px
    }

    .pair {
        display: flex;
        justify-content: space-between;
        gap: 12px
    }

    .btn {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 10px 14px;
        color: var(--txt);
        background: #122042;
        cursor: pointer;
        transition: background .2s,border-color .2s
    }

        .btn:hover {
            background: #162a58;
            border-color: #3352a6
        }

        .btn.danger {
            background: #3b1520;
            border-color: #6e2638
        }

            .btn.danger:hover {
                background: #571a28;
                border-color: #a43a54
            }

    .toaster {
        position: fixed;
        right: 16px;
        bottom: 16px;
        display: grid;
        gap: 8px;
        z-index: 50
    }

    .toast {
        opacity: 0;
        transform: translateY(6px);
        transition: .2s;
        border-radius: 10px;
        padding: 10px 14px;
        color: #0c1220;
        font-weight: 600
    }

        .toast.ok {
            background: #bfe6c6
        }

        .toast.err {
            background: #ffc2c2
        }

        .toast.show {
            opacity: 1;
            transform: translateY(0)
        }

    /* tamaño del mapa: máx 820px y centrado */
    .pz-map-wrap.square {
        aspect-ratio: 1/1;
        background: #0b152a;
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        max-width: 820px; /* <- controla el ancho máximo del mapa */
        width: 100%;
        margin: 0 auto; /* centrado */
    }

    .pz-map {
        width: 100%;
        height: 100%;
        display: block
    }

    .pz-slot.is-available:hover {
        filter: saturate(1.2)
    }

    .pz-busy {
        animation: pzPulse .6s linear infinite
    }

    /* IMPORTANTE: en Razor escribe @@keyframes para renderizar @@keyframes */
    @@keyframes pzPulse {
        0% {
            opacity: 1;
        }

        50% {
            opacity: .5;
        }

        100% {
            opacity: 1;
        }
    }</style>
