@page
@model ParkingZone.Pages.Client.ReservationModel
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Mis Reservas";
    var spacesJson = (string)(ViewData["SpacesJson"] ?? "[]");
    var currentReservation = Model.ActiveReservation;

    // Genera y expone el token antiforgery para fetch
    var tokens = Antiforgery.GetAndStoreTokens(HttpContext);
}
<!— token antiforgery accesible por JS —>
<meta name="request-verification-token" content="@tokens.RequestToken" />

@if (currentReservation != null)
{
    <section class="card active">
        <header class="bar">
            <h2>Tu reserva</h2>
            <span class="chip chip-live">Activa</span>
        </header>

        <div class="active-body">
            <div class="active-box">
                <div class="pair"><span>Espacio</span><strong>@currentReservation.Space.Code</strong></div>
                <div class="pair"><span>Inicio</span><strong>@currentReservation.EntryTime.ToLocalTime().ToString("HH:mm:ss")</strong></div>
                <div class="pair"><span>Tiempo restante</span><strong id="timer">--:--</strong></div>
            </div>

            <form method="post" asp-page-handler="Cancel" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn danger">Cancelar</button>
            </form>
        </div>
    </section>

    <script>
        (function(){
            const end = new Date("@currentReservation.EntryTime.AddMinutes(30).ToString("O")");
            const out = document.getElementById("timer");
            function tick(){
                const d = end - new Date();
                if (d <= 0){ out.textContent = "00:00"; location.reload(); return; }
                const m = Math.floor(d/60000), s = Math.floor((d%60000)/1000);
                out.textContent = String(m).padStart(2,"0")+":"+String(s).padStart(2,"0");
            }
            tick(); setInterval(tick,1000);
        })();
    </script>
}
else
{
    <section class="card">
        <header class="bar">
            <div>
                <h2>Reservar un espacio</h2>
                <p class="muted">Selecciona un espacio disponible. La reserva dura 30 minutos.</p>
            </div>
            <div class="legend">
                <span class="chip ok">Disponible</span>
                <span class="chip warn">No disponible</span>
                <span class="chip err">Ocupado</span>
            </div>
        </header>

        <section class="filters">
            <div class="field">
                <label for="f-q">Buscar</label>
                <input id="f-q" type="search" placeholder="Ej: A01" />
            </div>
            <label class="field check">
                <input id="f-only-available" type="checkbox" />
                <span>Sólo disponibles</span>
            </label>
        </section>

        <section class="grid-wrap">
            <div id="grid-spaces" class="grid"></div>
            <p id="grid-empty" class="muted" hidden>No hay espacios que coincidan.</p>
        </section>
    </section>

    <div id="toaster" class="toaster" aria-live="polite"></div>

    <script>
        // Dataset mínimo desde backend
        const PZ_SPACES = @Html.Raw(spacesJson);

        // Antiforgery
        const XSRF = document.querySelector('meta[name="request-verification-token"]')?.content ?? "";

        // UI refs
        const grid = document.getElementById("grid-spaces");
        const empty = document.getElementById("grid-empty");
        const q = document.getElementById("f-q");
        const onlyAvail = document.getElementById("f-only-available");
        const toast = document.getElementById("toaster");

        function render(){
            grid.innerHTML = "";
            let list = PZ_SPACES.slice();
            const query = (q.value||"").toLowerCase();
            const filterAvail = !!onlyAvail.checked;

            if (query) list = list.filter(x => x.code.toLowerCase().includes(query));
            if (filterAvail) list = list.filter(x => x.state === "available");

            empty.hidden = list.length > 0;

            for (const s of list){
                const el = document.createElement("button");
                el.type = "button";
                el.className = `tile ${s.state}`;
                el.setAttribute("aria-label", `Espacio ${s.code}, ${humanState(s.state)}`);
                el.innerHTML = `
                    <span class="badge">#${s.code}</span>
                    <span class="state">${humanState(s.state)}</span>
                `;
                if (s.state !== "available") el.disabled = true;
                el.addEventListener("click", () => reserve(s.id, el));
                grid.appendChild(el);
            }
        }

        function humanState(st){ return st==="busy"?"Ocupado":st==="reserved"?"No disponible":"Disponible"; }

        async function reserve(spaceId, el){
            el.classList.add("busyspin");
            try{
                const res = await fetch("/Client/Reservation?handler=Create", {
                    method: "POST",
                    headers: {
                        "Content-Type":"application/json",
                        "RequestVerificationToken": XSRF
                    },
                    body: JSON.stringify({ spaceId })
                });

                if (res.ok){
                    toastOk("Reserva creada, redirigiendo…");
                    setTimeout(()=>location.reload(), 600);
                } else {
                    const msg = await res.text();
                    toastErr(msg || "No se pudo reservar el espacio.");
                    el.classList.remove("busyspin");
                }
            } catch (e){
                toastErr("Error de red. Intenta de nuevo.");
                el.classList.remove("busyspin");
            }
        }

        function toastOk(msg){ showToast(msg, "ok"); }
        function toastErr(msg){ showToast(msg, "err"); }
        function showToast(msg, kind){
            const t = document.createElement("div");
            t.className = `toast ${kind}`;
            t.textContent = msg;
            toast.appendChild(t);
            requestAnimationFrame(()=>t.classList.add("show"));
            setTimeout(()=>{ t.classList.remove("show"); setTimeout(()=>t.remove(), 200); }, 2500);
        }

        [q, onlyAvail].forEach(el => el.addEventListener("input", render));
        render();
    </script>
}

<style>
    :root {
        --bg: #0f172a;
        --panel: #0b1222;
        --panel2: #0e1a31;
        --border: #1f2a44;
        --muted: #93a4bf;
        --txt: #e7eefc;
        --ok: #10b981;
        --warn: #f59e0b;
        --err: #ef4444;
        --primary: #3b82f6;
        --r: 14px;
    }

    body {
        background: linear-gradient(180deg,#0a1020,#0f1730 45%,#0b1222);
    }

    .card {
        background: linear-gradient(180deg,var(--panel),var(--panel2));
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 22px;
        color: var(--txt);
        box-shadow: 0 8px 24px rgba(0,0,0,.35)
    }

    .bar {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: end;
        flex-wrap: wrap;
        border-bottom: 1px solid var(--border);
        padding-bottom: 12px;
        margin-bottom: 18px
    }

    .muted {
        color: var(--muted);
        font-size: .95rem
    }

    .legend {
        display: flex;
        gap: 8px;
        flex-wrap: wrap
    }

    .chip {
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 4px 10px;
        font-weight: 600
    }

        .chip.ok {
            background: rgba(16,185,129,.12);
            color: #b6ffe0
        }

        .chip.warn {
            background: rgba(245,158,11,.12);
            color: #ffe1b3
        }

        .chip.err {
            background: rgba(239,68,68,.12);
            color: #ffb8b8
        }

    .chip-live {
        background: rgba(59,130,246,.12);
        color: #b3d0ff
    }

    .filters {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 12px;
        margin-bottom: 10px
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px
    }

    .check {
        flex-direction: row;
        align-items: center;
        gap: 8px
    }

    .field input[type="search"] {
        background: #0b152a;
        border: 1px solid var(--border);
        color: var(--txt);
        border-radius: 10px;
        padding: 10px
    }

    .grid-wrap {
        margin-top: 8px
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(160px,1fr));
        gap: 14px
    }

    .tile {
        position: relative;
        display: grid;
        gap: 8px;
        align-content: center;
        justify-items: center;
        padding: 16px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: #0b152a;
        color: var(--txt);
        cursor: pointer;
        transition: transform .15s, box-shadow .15s, border-color .15s
    }

        .tile:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,.25)
        }

        .tile .badge {
            font-weight: 700;
            letter-spacing: .5px
        }

        .tile .state {
            font-size: .95rem;
            color: var(--muted)
        }

        .tile.available {
            outline: 2px solid rgba(16,185,129,.22)
        }

        .tile.reserved {
            outline: 2px solid rgba(245,158,11,.22);
            filter: saturate(0.8)
        }

        .tile.busy {
            outline: 2px solid rgba(239,68,68,.22);
            filter: saturate(0.8)
        }

        .tile:disabled {
            opacity: .5;
            cursor: not-allowed
        }

        .tile.busyspin::after {
            content: "";
            position: absolute;
            inset: auto 12px 12px auto;
            width: 16px;
            height: 16px;
            border: 2px solid #7aa2ff;
            border-top-color: transparent;
            border-radius: 50%;
            animation: spin .8s linear infinite
        }
    keyframes spin {
        to

    {
        transform: rotate(360deg)
    }

    }

    .active {
        max-width: 600px;
        margin-inline: auto
    }

    .active-body {
        display: grid;
        gap: 18px
    }

    .active-box {
        display: grid;
        gap: 10px;
        background: #0b152a;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 14px
    }

    .pair {
        display: flex;
        justify-content: space-between;
        gap: 12px
    }

    .btn {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 10px 14px;
        color: var(--txt);
        background: #122042;
        cursor: pointer;
        transition: background .2s,border-color .2s
    }

        .btn:hover {
            background: #162a58;
            border-color: #3352a6
        }

        .btn.danger {
            background: #3b1520;
            border-color: #6e2638
        }

            .btn.danger:hover {
                background: #571a28;
                border-color: #a43a54
            }

    .toaster {
        position: fixed;
        right: 16px;
        bottom: 16px;
        display: grid;
        gap: 8px;
        z-index: 50
    }

    .toast {
        opacity: 0;
        transform: translateY(6px);
        transition: .2s;
        border-radius: 10px;
        padding: 10px 14px;
        color: #0c1220;
        font-weight: 600
    }

        .toast.ok {
            background: #bfe6c6
        }

        .toast.err {
            background: #ffc2c2
        }

        .toast.show {
            opacity: 1;
            transform: translateY(0)
        }
</style>
