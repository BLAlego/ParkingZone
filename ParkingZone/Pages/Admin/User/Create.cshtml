@page
@model ParkingZone.Pages.Admin.User.CreateModel
@{
    ViewData["Title"] = "Crear usuario";
}

<div class="pz-container my-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="pz-head h3 mb-0">Crear usuario</h1>
            <small class="text-muted">Completa los datos para registrar un nuevo usuario</small>
        </div>
        <a asp-page="Index" class="btn btn-outline-secondary btn-tile">
            ↩️ Volver
        </a>
    </div>

    <div class="card pz-card shadow-sm col-12 col-xl-10 mx-auto">
        <div class="card-body p-4">
            <form method="post" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger py-2 mb-4"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="User.Name" class="form-control" placeholder="Mariel Vargas">
                            <label asp-for="User.Name">Nombre completo <span class="text-danger">*</span></label>
                        </div>
                        <span class="field-error" asp-validation-for="User.Name"></span>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="User.Email" type="email" class="form-control" placeholder="usuario@correo.com">
                            <label asp-for="User.Email">Email <span class="text-danger">*</span></label>
                        </div>
                        <span class="field-error" asp-validation-for="User.Email"></span>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="User.Phone" class="form-control" placeholder="70000000">
                            <label asp-for="User.Phone">Teléfono</label>
                        </div>
                        <span class="field-error" asp-validation-for="User.Phone"></span>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="User.Role" class="form-select"
                                    asp-items="Html.GetEnumSelectList<ParkingZone.Models.UserRole>()">
                            </select>
                            <label asp-for="User.Role">Rol</label>
                        </div>
                        <span class="field-error" asp-validation-for="User.Role"></span>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••">
                            <label asp-for="Password">Password <span class="text-danger">*</span></label>
                        </div>
                        <span class="field-error" asp-validation-for="Password"></span>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••">
                            <label asp-for="ConfirmPassword">Confirmar Password <span class="text-danger">*</span></label>
                        </div>
                        <span class="field-error" asp-validation-for="ConfirmPassword"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="User.IsActive" id="isActive">
                            <label class="form-check-label" for="isActive">Activo</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2 justify-content-center">
                    <button type="submit" class="btn btn-primary btn-tile">✅ Crear</button>
                    <a asp-page="Index" class="btn btn-outline-secondary btn-tile">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
