@page
@model ParkingZone.Pages.Admin.User.DeleteModel
@{
    ViewData["Title"] = "Eliminar usuario";
}

<div class="pz-container my-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="pz-head h3 mb-0 text-danger">Eliminar usuario</h1>
            <small class="text-muted">Esta acción no se puede deshacer</small>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary btn-tile">↩️ Volver</a>
    </div>

    <div class="card pz-card border-danger-subtle shadow-sm col-12 col-xl-9 mx-auto">
        <div class="card-body p-4">
            <div class="alert alert-danger d-flex align-items-start" role="alert">
                <div class="me-2 fs-5">🗑️</div>
                <div>
                    <strong>¿Seguro que deseas eliminar este usuario?</strong><br />
                    Revisa la información antes de confirmar.
                </div>
            </div>

            <dl class="row small lh-base">
                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.User.Name)</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9"><a href="mailto:@Model.User.Email">@Model.User.Email</a></dd>

                <dt class="col-sm-3">Teléfono</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.User.Phone)</dd>

                <dt class="col-sm-3">Rol</dt>
                <dd class="col-sm-9"><span class="badge role-badge">@Html.DisplayFor(m => m.User.Role)</span></dd>

                <dt class="col-sm-3">HashPassword</dt>
                <dd class="col-sm-9"><span class="truncate-1 d-inline-block" style="max-width: 100%">@Html.DisplayFor(m => m.User.HashPassword)</span></dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">@(Model.User.IsActive ? "Activo" : "Inactivo")</dd>

                <dt class="col-sm-3">Registro</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.User.RegistrationDate)</dd>
            </dl>

            <form method="post" class="d-flex gap-2 justify-content-center mt-4">
                <input type="hidden" asp-for="User.Id" />
                <input type="submit" value="Eliminar" class="btn btn-danger btn-tile" />
                <a asp-page="./Index" class="btn btn-outline-secondary btn-tile">Cancelar</a>
            </form>
        </div>
    </div>
</div>
