@page
@model ParkingZone.Pages.Admin.User.DetailsModel
@{
    ViewData["Title"] = "Detalle de usuario";
}

<div class="pz-container my-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="pz-head h3 mb-0">Detalle de usuario</h1>
            <small class="text-muted">Información completa del usuario</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="./Edit" asp-route-id="@Model.User.Id" class="btn btn-primary btn-tile">✏️ Editar</a>
            <a asp-page="./Index" class="btn btn-outline-secondary btn-tile">↩️ Volver</a>
        </div>
    </div>

    <div class="card pz-card shadow-sm col-12 col-xxl-9 mx-auto">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="info-block">
                        <div class="label">Nombre</div>
                        <div class="value">@Model.User.Name</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-block">
                        <div class="label">Email</div>
                        <div class="value"><a href="mailto:@Model.User.Email">@Model.User.Email</a></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-block">
                        <div class="label">Teléfono</div>
                        <div class="value">@Model.User.Phone</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-block">
                        <div class="label">Rol</div>
                        <div class="value"><span class="badge role-badge">@Model.User.Role</span></div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="info-block">
                        <div class="label">HashPassword</div>
                        <pre class="code-block mt-1">@Model.User.HashPassword</pre>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-block">
                        <div class="label">Estado</div>
                        <div class="value">@(Model.User.IsActive ? "Activo" : "Inactivo")</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-block">
                        <div class="label">Registrado</div>
                        <div class="value">@Model.User.RegistrationDate.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2 justify-content-center">
                <a asp-page="./Edit" asp-route-id="@Model.User.Id" class="btn btn-primary btn-tile">✏️ Editar</a>
                <a asp-page="./Index" class="btn btn-outline-secondary btn-tile">↩️ Volver</a>
            </div>
        </div>
    </div>
</div>
