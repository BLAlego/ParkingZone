@page
@model ParkingZone.Pages.Admin.User.IndexModel
@{
    ViewData["Title"] = "Usuarios";
}

<div class="pz-container my-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="pz-head h3 mb-0">Usuarios</h1>
            <small class="text-muted">Administración de cuentas</small>
        </div>
        <a asp-page="Create" class="btn btn-primary btn-tile">➕ Crear nuevo</a>
    </div>

    <div class="card pz-card mb-3 shadow-sm">
        <div class="card-body">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text">🔍</span>
                        <input id="txtSearch" type="search" class="form-control" placeholder="Buscar por nombre, email o teléfono…">
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="form-floating">
                        <select id="selEstado" class="form-select">
                            <option value="">Todos</option>
                            <option value="true">Activos</option>
                            <option value="false">Inactivos</option>
                        </select>
                        <label for="selEstado">Estado</label>
                    </div>
                </div>
                <div class="col-6 col-md-3 text-md-end">
                    <span class="chip">Total: @Model.User?.Count</span>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive pz-card shadow-sm">
        <table class="table table-hover align-middle mb-0 table-list">
            <thead class="table-light sticky-top z-1">
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Rol</th>
                    <th class="d-none d-xl-table-cell">HashPassword</th>
                    <th>Estado</th>
                    <th>Registro</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody id="tblBody">
                @foreach (var item in Model.User)
                {
                    var roleClass = item.Role switch
                    {
                        ParkingZone.Models.UserRole.admin => "role-admin",
                        ParkingZone.Models.UserRole.worker => "role-worker",
                        _ => "role-client"
                    };
                    <tr data-search="@($"{item.Name} {item.Email} {item.Phone}").ToLower()" data-active="@item.IsActive.ToString().ToLower()">
                        <td class="fw-semibold">@item.Name</td>
                        <td><a href="mailto:@item.Email" class="text-decoration-none">@item.Email</a></td>
                        <td>@item.Phone</td>
                        <td><span class="badge @roleClass">@item.Role</span></td>
                        <td class="d-none d-xl-table-cell">
                            @if (!string.IsNullOrEmpty(item.HashPassword) && item.HashPassword.Length > 40)
                            {
                                <span class="truncate-1" title="@item.HashPassword">@item.HashPassword</span>
                            }
                            else
                            {
                                @item.HashPassword
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">Inactivo</span>
                            }
                        </td>
                        <td class="text-nowrap">@item.RegistrationDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center text-nowrap">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-ix">
                                    <span class="ix">👁️</span><span class="d-none d-lg-inline"> Ver</span>
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-ix">
                                    <span class="ix">✏️</span><span class="d-none d-lg-inline"> Editar</span>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-ix">
                                    <span class="ix">🗑️</span><span class="d-none d-lg-inline"> Eliminar</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
          const search = document.getElementById('txtSearch');
          const estado = document.getElementById('selEstado');
          const rows = [...document.querySelectorAll('#tblBody tr')];
          const apply = () => {
            const q = (search.value || '').trim().toLowerCase();
            const st = (estado.value || '');
            rows.forEach(r => {
              const okQ = r.dataset.search.includes(q);
              const okS = st === '' || r.dataset.active === st;
              r.style.display = (okQ && okS) ? '' : 'none';
            });
          };
          search.addEventListener('input', apply);
          estado.addEventListener('change', apply);
        })();
    </script>
}
