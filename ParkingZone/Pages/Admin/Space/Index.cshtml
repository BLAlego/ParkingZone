@page
@model ParkingZone.Pages.Admin.Space.IndexModel
@{
    ViewData["Title"] = "Espacios";
}

<!-- ===== DISEÑO AUTO-CONTENIDO SIN DEPENDENCIAS ===== -->
<style>
    body {
        font-family: Arial, Helvetica, sans-serif;
        background: radial-gradient(circle at top, #101a34 0%, #0b1222 90%);
        color: #e7eefc;
        margin: 0;
        padding: 30px;
    }

    .container {
        max-width: 1000px;
        margin: auto;
        background: #0f172a;
        border: 1px solid #22304b;
        border-radius: 14px;
        box-shadow: 0 8px 25px rgba(0,0,0,.35);
        padding: 25px;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

        .header h1 {
            margin: 0;
            font-size: 1.6rem;
        }

    .btn-main {
        background: #3b82f6;
        color: white;
        border: 2px solid #3b82f6;
        border-radius: 8px;
        padding: 8px 16px;
        text-decoration: none;
        font-weight: 600;
        transition: all .25s;
    }

        .btn-main:hover {
            background: #facc15;
            border-color: #facc15;
            color: #0f172a;
        }

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

    thead th {
        text-align: center;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #9fb1d1;
        border-bottom: 1px solid #22304b;
        padding-bottom: 10px;
    }

    tbody tr {
        background: #0b1222;
        transition: all .15s;
    }

        tbody tr:hover {
            background: #16294f;
            transform: scale(1.01);
        }

    td {
        text-align: center;
        padding: 10px;
        color: #e2e8f0;
        border-top: 1px solid #1f2a44;
    }

    .badge-type {
        background: #2563eb;
        color: #fff;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 600;
    }

    .badge-level {
        background: #334155;
        color: #e2e8f0;
        border-radius: 6px;
        padding: 3px 8px;
        font-size: .8rem;
        font-weight: 600;
    }

    .avail-yes {
        color: #22c55e;
        font-weight: 600;
    }

    .avail-no {
        color: #ef4444;
        font-weight: 600;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 2px solid #3b82f6;
        background: #0f172a;
        color: #3b82f6;
        cursor: pointer;
        transition: all .25s;
    }

        .btn-icon:hover {
            background: #facc15;
            border-color: #facc15;
            color: #0f172a;
            transform: translateY(-2px);
        }

    .icon {
        width: 20px;
        height: 20px;
        fill: currentColor;
    }
</style>

<div class="container">
    <div class="header">
        <h1>Espacios</h1>
        <a asp-page="Create" class="btn-main">+ Nuevo</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.Space[0].Code)</th>
                <th>@Html.DisplayNameFor(m => m.Space[0].Type)</th>
                <th>@Html.DisplayNameFor(m => m.Space[0].Available)</th>
                <th>@Html.DisplayNameFor(m => m.Space[0].Level)</th>
                <th>@Html.DisplayNameFor(m => m.Space[0].HourlyRate)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Space)
            {
                <tr>
                    <td>@item.Code</td>
                    <td><span class="badge-type">@item.Type</span></td>
                    <td>
                        @if (item.Available)
                        {
                            <span class="avail-yes">&#10003; Sí</span>
                        }
                        else
                        {
                            <span class="avail-no">&#10007; No</span>
                        }
                    </td>
                    <td><span class="badge-level">L @item.Level</span></td>
                    <td>@item.HourlyRate.ToString("0.00")</td>
                    <td class="actions">
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn-icon" title="Detalles">
                            <svg class="icon" viewBox="0 0 16 16">
                                <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V5.5L9.5 0H4zm5 1.5L13.5 6H9a.5.5 0 0 1-.5-.5V1.5z" />
                            </svg>
                        </a>


                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn-icon" title="Editar">
                            <svg class="icon" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708L4.207 15.5H1v-3.207L12.146.146zM2 13.793V14.5h.707l9.793-9.793-.707-.707L2 13.793z" /></svg>
                        </a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn-icon" title="Eliminar">
                            <svg class="icon" viewBox="0 0 16 16"><path d="M5.5 5.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0V6H6v6.5a.5.5 0 0 1-1 0v-7z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4H2.5a1 1 0 0 1-1-1V2h13v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118z" /></svg>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
