@page
@model ParkingZone.Pages.Admin.Parking.EditModel
@{
    ViewData["Title"] = "Editar parqueo";
}

<style>
    body {
        margin: 0;
        padding: 30px;
        background: radial-gradient(circle at top,#101a34 0%,#0b1222 90%);
        color: #e7eefc;
        font-family: Arial,Helvetica,sans-serif
    }

    .card {
        max-width: 900px;
        margin: auto;
        background: #0f172a;
        border: 1px solid #22304b;
        border-radius: 14px;
        box-shadow: 0 8px 25px rgba(0,0,0,.35);
        padding: 24px
    }

    .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px
    }

        .header h1 {
            margin: 0;
            font-size: 1.6rem
        }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 8px;
        border: 2px solid transparent;
        padding: 8px 16px;
        font-weight: 700;
        text-decoration: none;
        transition: all .22s;
        cursor: pointer
    }

    .btn-primary {
        background: #3b82f6;
        border-color: #3b82f6;
        color: #fff
    }

        .btn-primary:hover {
            background: #facc15;
            border-color: #facc15;
            color: #0f172a
        }

    .btn-ghost {
        background: transparent;
        border-color: #334155;
        color: #cbd5e1
    }

        .btn-ghost:hover {
            background: #1b2a4a;
            color: #fff
        }

    .form {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 14px
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px
    }

        .field label {
            font-size: .9rem;
            color: #9fb1d1
        }

    .input {
        width: 100%;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid #2a3a5a;
        background: #0b1324;
        color: #e2e8f0;
        transition: border .15s,box-shadow .15s
    }

        .input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,.25)
        }

    .help {
        color: #fda4af;
        font-size: .85rem
    }

    .actions {
        display: flex;
        gap: 10px;
        margin-top: 16px
    }
</style>

<div class="card">
    <div class="header">
        <h1>Editar parqueo</h1>
        <a asp-page="./Index" class="btn btn-ghost">← Volver</a>
    </div>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="help"></div>

        <!-- Clave compuesta -->
        <input type="hidden" asp-for="Parking.SpaceId" />
        <input type="hidden" asp-for="Parking.VehicleId" />
        <input type="hidden" asp-for="Parking.EntryTime" />

        <div class="form">
            <div class="field">
                <label asp-for="Parking.ExitTime">Salida</label>
                <input asp-for="Parking.ExitTime" class="input" />
                <span asp-validation-for="Parking.ExitTime" class="help"></span>
            </div>

            <div class="field">
                <label asp-for="Parking.Profit">Ganancia</label>
                <input asp-for="Parking.Profit" class="input" />
                <span asp-validation-for="Parking.Profit" class="help"></span>
            </div>
        </div>

        <div class="actions">
            <input type="submit" value="Guardar" class="btn btn-primary" />
            <a asp-page="./Index" class="btn btn-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
