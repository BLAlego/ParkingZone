@page
@model ParkingZone.Pages.Admin.Parking.CreateModel

        @{
        ViewData["Title"] = "Create";
        }
        
        <h1>Create</h1>
        
    <h4>Parking</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Parking.SpaceId" class="control-label"></label>
                <select asp-for="Parking.SpaceId" class ="form-control" asp-items="ViewBag.SpaceId"></select>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Parking.VehicleId" class="control-label"></label>
                <select asp-for="Parking.VehicleId" class ="form-control" asp-items="ViewBag.VehicleId"></select>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Parking.EntryTime" class="control-label"></label>
                <input asp-for="Parking.EntryTime" class="form-control" />
                <span asp-validation-for="Parking.EntryTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Parking.ExitTime" class="control-label"></label>
                <input asp-for="Parking.ExitTime" class="form-control" />
                <span asp-validation-for="Parking.ExitTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Parking.Profit" class="control-label"></label>
                <input asp-for="Parking.Profit" class="form-control" />
                <span asp-validation-for="Parking.Profit" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
