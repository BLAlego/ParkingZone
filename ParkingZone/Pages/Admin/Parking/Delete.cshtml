@page
@model ParkingZone.Pages.Admin.Parking.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Parking</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Parking.ExitTime)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Parking.ExitTime)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Parking.Profit)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Parking.Profit)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Parking.Space)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Parking.Space.Code)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Parking.Vehicle)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Parking.Vehicle.Plate)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Parking.SpaceId" />
        <input type="hidden" asp-for="Parking.VehicleId" />
        <input type="hidden" asp-for="Parking.EntryTime" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
