@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "ParkingZone")</title>

    <!-- Bootstrap (LOCAL) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- (Opcional) Bootstrap Icons por CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- CSS del proyecto -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ParkingZone.styles.css" asp-append-version="true" />

    <style>
        :root {
            --bg: #0f172a;
            --panel: #0b1222;
            --panel2: #0e1a31;
            --border: #1f2a44;
            --muted: #93a4bf;
            --txt: #e7eefc;
            --primary: #3b82f6;
            --r: 14px;
        }

        html, body {
            height: 100%;
        }

        body {
            background: linear-gradient(180deg, #0a1020, #0f1730 45%, #0b1222);
            color: var(--txt);
        }

        /* NAVBAR */
        .navwrap {
            background: linear-gradient(180deg, var(--panel), var(--panel2));
            border-bottom: 1px solid var(--border);
            box-shadow: 0 12px 24px rgba(0,0,0,.25);
            margin-bottom: 18px;
        }

        .navbar {
            padding-block: 10px;
        }

        .navbar-brand {
            color: #cfe0ff !important;
            font-weight: 700;
            letter-spacing: .2px;
        }

        .nav-link {
            color: #b8c5e6 !important;
            position: relative;
        }

            .nav-link:hover {
                color: #fff !important;
            }

            .nav-link::after {
                content: "";
                position: absolute;
                left: 8px;
                right: 8px;
                bottom: 4px;
                height: 2px;
                background: transparent;
                transform: scaleX(0);
                transition: background .2s, transform .2s;
            }

            .nav-link:hover::after {
                background: #5b8bff;
                transform: scaleX(1);
            }

        .chip {
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 4px 10px;
            color: #b3d0ff;
            background: rgba(59,130,246,.12);
            font-weight: 600;
            font-size: .9rem;
        }

        /* CONTENIDO */
        .shell {
            padding-block: 18px;
        }

        .panel {
            background: linear-gradient(180deg, var(--panel), var(--panel2));
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 22px;
            box-shadow: 0 8px 24px rgba(0,0,0,.35);
        }

        /* FOOTER */
        .footer {
            background: #0b1324;
        }

        .footer-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: nowrap;
            padding-block: .6rem;
            border-top: 1px solid var(--border);
        }

            .footer-bar .links,
            .footer-bar .right {
                display: flex;
                align-items: center;
                gap: .75rem;
            }

            .footer-bar .icons {
                display: flex;
                gap: .5rem;
                font-size: 1.15rem;
            }

            .footer-bar a {
                color: #b6c7ff !important;
                text-decoration: none;
            }

                .footer-bar a:hover {
                    color: #fff !important;
                    text-decoration: underline;
                }

            .footer-bar .bi {
                vertical-align: -2px;
            }

     
        @@media (max-width: 576px) {
            .footer-bar

        {
            flex-wrap: wrap;
            row-gap: .25rem;
        }

        }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">
    <header class="navwrap">
        <nav class="navbar navbar-expand-sm navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">ParkingZone</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Privacy">Privacidad</a></li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
                            var name = User.Identity?.Name ?? "";
                            <li class="nav-item d-flex align-items-center me-2">
                                <span class="chip">@name (@role)</span>
                            </li>
                            <li class="nav-item">
                                <form asp-page="/Account/Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-page="/Account/Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container shell flex-fill">
        <main role="main" class="panel">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3">
        <div class="container footer-bar small">
            <div class="row align-items-center text-center text-md-start w-100">
                <div class="col-md-6 mb-2 mb-md-0">
                    <nav class="links d-flex justify-content-center justify-content-md-start align-items-center gap-2 flex-wrap">
                        <a href="https://www.univalle.edu/" target="_blank" rel="noopener">Univalle</a>
                        <span class="text-secondary">•</span>
                        <a asp-page="/Privacy">Privacidad</a>
                        <span class="text-secondary">•</span>
                        <a href="mailto:soporte@parkingzone.com">Contacto</a>
                    </nav>
                </div>

                <div class="col-md-6 d-flex justify-content-center justify-content-md-end align-items-center gap-3">
                    <div class="icons d-flex gap-3">
                        <a href="https://www.facebook.com/UnivalleBolivia/" target="_blank" aria-label="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="https://www.instagram.com/univalle_bolivia/" target="_blank" aria-label="Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="https://www.linkedin.com/school/univallebolivia/" target="_blank" aria-label="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>
                    </div>
                    <span class="text-secondary small">© @DateTime.UtcNow.Year · ParkingZone</span>
                </div>
            </div>
        </div>
    </footer>


    <!-- JS (LOCAL) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
